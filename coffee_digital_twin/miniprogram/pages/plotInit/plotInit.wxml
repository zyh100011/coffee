<view class="page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答由规则生成，仅用于联调"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放，具体生成时间见证据"/><banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><loading-panel wx:if="{{state === 'loading'}}" text="加载中"/><view class="page-title">{{plotId ? '编辑地块' : '地块录入'}}</view><view wx:if="{{isDev}}" class="muted section">缺项留空；已有来源随档案保存。</view><button wx:if="{{isDev}}" class="btn-link" bindtap="toggleSources">标注来源 {{showSources ? '收起' : '›'}}</button><view wx:for="{{groups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="title" class="panel section"><view class="section-title">{{group.title}}</view><view wx:for="{{group.fields}}" wx:for-item="field" wx:for-index="fieldIndex" wx:key="key" class="field"><text class="field-label">{{field.label}}</text><input class="input" type="{{field.type}}" value="{{values[field.key]}}" data-key="{{field.key}}" bindinput="input" placeholder="请填写{{field.label}}" aria-label="{{field.label}}"/><view wx:if="{{isDev && field.note}}" class="muted">{{field.note}}</view><view wx:if="{{fieldErrors[field.key]}}" class="error-text">{{fieldErrors[field.key]}}</view><picker wx:if="{{isDev && showSources}}" range="{{sources}}" value="{{field.sourceIndex}}" data-group="{{groupIndex}}" data-index="{{fieldIndex}}" bindchange="source" aria-label="{{field.label}}来源"><view class="picker">来源：{{sources[field.sourceIndex]}} ▾</view></picker></view></view><button class="primary-btn" bindtap="save" loading="{{saving}}" disabled="{{saving || state === 'loading' || state === 'offline'}}">保存地块</button></view>
