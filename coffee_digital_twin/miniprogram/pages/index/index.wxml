<view class="page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答由规则生成，仅用于联调"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放，具体生成时间见证据"/><banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><loading-panel wx:if="{{state === 'loading'}}" text="加载中"/><empty-state wx:if="{{state === 'empty'}}" title="还没有地块" desc="选择或新建地块后开始使用" action-text="新建地块" bind:action="create"/><block wx:if="{{plot}}"><view class="page-title">咖啡农事循证决策助手</view><view class="panel section" bindtap="create" aria-role="button" aria-label="查看地块档案"><view class="section-title">档案完整度 {{plot.completeness.filled}}/12 ›</view><view class="muted">缺：{{missingText || '无'}}</view></view><view class="panel section"><view class="section-title">最近墒情</view><block wx:if="{{moisture}}"><status-card label="{{moistureLabel}}" value="{{moisture.outputs.mean}}" unit="{{moisture.units.value}}" source-type="{{moisture.source_type}}" status="{{moisture.status}}" sub="{{moisture.time_range.start}} 至 {{moisture.time_range.end}}"/><view class="muted">{{sourceLabel}} · 历史观测</view><view wx:for="{{moisture.warnings}}" wx:key="*this" class="muted">{{item}}</view><line-chart series="{{series}}" unit="{{moisture.units.value}}"/></block><view wx:else class="muted">该地块暂无可用的土壤湿度监测数据</view></view><view class="panel section"><view class="section-title">快捷提问</view><button data-question="这块地40cm最近一周墒情怎么样" bindtap="ask">这块地40cm最近一周墒情怎么样</button><button data-question="咖啡根系主要分布在多深" bindtap="ask">咖啡根系主要分布在多深</button><button data-question="如果多浇20mm，土壤水分会怎样" bindtap="ask">如果多浇20mm，土壤水分会怎样</button></view><view class="panel section"><view class="section-title">模型工具状态</view><view wx:for="{{tools}}" wx:key="name"><text>{{item.name}}</text><evidence-tag source-type="{{item.source_type}}" status="{{item.status}}"/></view><view wx:if="{{!tools.length}}" class="muted">暂无本地块模型结果</view></view><view class="actions"><button bindtap="farm">农事记录</button><button bindtap="result">模型结果</button><button bindtap="reports">历史报告</button></view></block></view>
