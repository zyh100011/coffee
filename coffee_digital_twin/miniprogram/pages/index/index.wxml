<view class="page"><plot-bar plot="{{plot}}" mode-switch="{{true}}" bind:modechange="viewModeChanged"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答由规则生成，仅用于联调"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放，具体生成时间见证据"/><banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><loading-panel wx:if="{{state === 'loading'}}" text="加载中"/><empty-state wx:if="{{state === 'empty'}}" title="后端未导入基地数据" desc="请按操作手册导入基地资料" bind:action="create"/><block wx:if="{{plot}}"><view class="panel section" bindtap="create" aria-role="button" aria-label="查看地块档案"><view wx:if="{{isDev}}" class="section-title">档案完整度 {{plot.completeness.filled}}/12 ›</view><view wx:else class="section-title">基地档案 ›</view><view wx:if="{{isDev}}" class="muted">缺：{{missingText || '无'}}</view></view><view class="panel section"><view class="section-title">最近墒情</view><block wx:if="{{moisture}}"><status-card label="{{moistureLabel}}" value="{{moisture.outputs.mean}}" unit="{{moisture.units.value}}" source-type="{{moisture.source_type}}" status="{{moisture.status}}" sub="{{moisture.time_range.start}} 至 {{moisture.time_range.end}}"/><view wx:if="{{isDev}}" class="muted">{{sourceLabel}} · 历史观测</view><line-chart series="{{series}}" unit="{{moisture.units.value}}"/><button wx:if="{{isDev}}" class="btn-link" bindtap="moistureEvidence">查看数据依据 ›</button></block><view wx:else class="muted">该地块暂无可用的土壤湿度监测数据</view></view><view class="panel section"><view class="section-title">快捷提问</view><button class="chip" data-question="30–45cm 最近一周墒情怎么样" bindtap="ask">30–45cm 最近一周墒情怎么样</button><button class="chip" data-question="咖啡叶片营养采样需要记录哪些信息？" data-mode="knowledge" bindtap="ask">咖啡叶片营养采样需要记录哪些信息？</button><button class="chip" data-question="如果多浇20mm，土壤水分会怎样" bindtap="ask">如果多浇20mm，土壤水分会怎样</button></view><view class="panel section"><view class="section-title">模型工具状态</view><view wx:for="{{tools}}" wx:key="name"><text>{{item.displayName}}</text><evidence-tag source-type="{{item.source_type}}" status="{{item.status}}"/></view><view wx:if="{{!tools.length}}" class="muted">暂无本地块模型结果</view></view><view class="actions"><button bindtap="farm">农事记录</button><button bindtap="result">模型结果</button><button bindtap="reports">历史报告</button></view></block></view>
