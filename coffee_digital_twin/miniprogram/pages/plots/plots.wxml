<view class="page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答由规则生成，仅用于联调"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放，具体生成时间见证据"/><banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><loading-panel wx:if="{{state === 'loading'}}" text="加载中"/><empty-state wx:if="{{state === 'empty'}}" title="后端未导入基地数据" desc="请按操作手册导入基地资料" bind:action="create"/><view wx:for="{{items}}" wx:key="plot_id" class="panel section"><view class="section-title">{{item.plot_name}} {{current === item.plot_id ? '· 当前' : ''}}</view><view>{{item.coffee_variety || '品种未填写'}}</view><view>面积 {{item.areaText}} 亩 · 海拔 {{item.elevationText}} 米</view><view>土质：{{item.soil_type}} · 密度：约 {{item.plant_density}} 株/亩</view><view>行距 {{item.row_spacing_m}} m · 株距 {{item.plant_spacing_m}} m</view><view>质地：{{item.soil_texture}}</view><view wx:for="{{item.soil_bulk_density.layers}}" wx:for-item="layer" wx:key="top_cm">{{layer.top_cm}}–{{layer.bottom_cm}}cm 容重 {{layer.value}} g/cm³</view><button wx:if="{{isDev}}" class="btn-link" bindtap="toggleNotes">档案说明 {{notesOpen ? '收起' : '›'}}</button><block wx:if="{{isDev && notesOpen}}"><view wx:if="{{item.coordinate_source}}" class="muted">定位来源：{{item.coordinate_source}}</view><view wx:if="{{item.irrigation_management}}">供水：{{item.irrigation_management}}</view><view wx:if="{{item.fertilizer_management}}">施肥：{{item.fertilizer_management}}</view><view wx:for="{{item.referenceNotes}}" wx:for-item="reference" wx:key="key" class="muted">{{reference.note}}</view></block><view wx:if="{{isDev}}" class="muted">档案 {{item.completeness.filled}}/{{item.completeness.total}} · 缺：{{item.missingText || '无'}}</view><view class="actions"><button wx:if="{{!item.single_base}}" data-id="{{item.plot_id}}" bindtap="select" aria-label="设为当前地块">设为当前</button><button data-id="{{item.plot_id}}" bindtap="edit" aria-label="编辑地块">编辑</button><button data-id="{{item.plot_id}}" bindtap="farm" aria-label="农事记录">农事记录</button></view></view><button wx:if="{{state !== 'empty' && !singleBase}}" class="primary-btn" bindtap="create">新建地块</button></view>
