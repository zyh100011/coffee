<view class="page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答由规则生成，仅用于联调"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放，具体生成时间见证据"/><banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><loading-panel wx:if="{{state === 'loading'}}" text="加载中"/><empty-state wx:if="{{state === 'empty'}}" title="后端未导入基地数据" desc="请按操作手册导入基地资料" bind:action="create"/><view wx:for="{{items}}" wx:key="plot_id" class="panel section"><view class="card-head"><view class="ic-box tint-green"><image class="ic-img" src="/images/ic/base.png"/></view><view class="grow"><view class="title">{{item.plot_name}}</view><view class="sub">{{item.coffee_variety || '品种未填写'}}</view></view><text wx:if="{{current === item.plot_id}}" class="pill">当前</text></view><view class="tiles"><view class="tile"><view class="t-label">面积</view><view class="t-value">{{item.areaText}}<text class="u">亩</text></view></view><view class="tile"><view class="t-label">海拔</view><view class="t-value">{{item.elevationText}}<text class="u">m</text></view></view><view class="tile"><view class="t-label">土质</view><view class="t-value small">{{item.soil_type || '—'}}</view></view><view class="tile"><view class="t-label">种植密度</view><view class="t-value">{{item.plant_density ? '约 ' + item.plant_density : '—'}}<text wx:if="{{item.plant_density}}" class="u">株/亩</text></view></view><view class="tile"><view class="t-label">行距 × 株距</view><view class="t-value">{{item.row_spacing_m || '—'}} × {{item.plant_spacing_m || '—'}}<text class="u">m</text></view></view><view class="tile"><view class="t-label">土壤质地</view><view class="t-value small">{{item.soil_texture || '—'}}</view></view></view><view wx:if="{{item.soil_bulk_density.layers.length}}" class="data-table bulk"><view class="tr th"><text>土层</text><text>容重 g/cm³</text></view><view wx:for="{{item.soil_bulk_density.layers}}" wx:for-item="layer" wx:key="top_cm" class="tr"><text>{{layer.top_cm}}–{{layer.bottom_cm}} cm</text><text>{{layer.value}}</text></view></view><button wx:if="{{isDev}}" class="btn-link" bindtap="toggleNotes">档案说明 {{notesOpen ? '收起' : '›'}}</button><block wx:if="{{isDev && notesOpen}}"><view wx:if="{{item.coordinate_source}}" class="muted">定位来源：{{item.coordinate_source}}</view><view wx:if="{{item.irrigation_management}}">供水：{{item.irrigation_management}}</view><view wx:if="{{item.fertilizer_management}}">施肥：{{item.fertilizer_management}}</view><view wx:for="{{item.referenceNotes}}" wx:for-item="reference" wx:key="key" class="muted">{{reference.note}}</view></block><view wx:if="{{isDev}}" class="muted">档案 {{item.completeness.filled}}/{{item.completeness.total}} · 缺：{{item.missingText || '无'}}</view><view class="actions"><button wx:if="{{!item.single_base}}" data-id="{{item.plot_id}}" bindtap="select" aria-label="设为当前地块">设为当前</button><button data-id="{{item.plot_id}}" bindtap="edit" aria-label="编辑地块">编辑</button><button data-id="{{item.plot_id}}" bindtap="farm" aria-label="农事记录">农事记录</button></view></view><button wx:if="{{state !== 'empty' && !singleBase}}" class="primary-btn" bindtap="create">新建地块</button></view>
