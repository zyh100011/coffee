<view class="page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答由规则生成，仅用于联调"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放，具体生成时间见证据"/><banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><loading-panel wx:if="{{state === 'loading'}}" text="加载中"/><view class="page-title">地块档案</view><empty-state wx:if="{{state === 'empty'}}" title="还没有地块" desc="先录入名称，其他资料可随后补齐" action-text="新建地块" bind:action="create"/><view wx:for="{{items}}" wx:key="plot_id" class="panel section"><view class="section-title">{{item.plot_name}} {{current === item.plot_id ? '· 当前' : ''}}</view><view>{{item.coffee_variety || '品种未填写'}}</view><view>面积 {{item.areaText}} 亩 · 海拔 {{item.elevationText}} 米</view><view wx:if="{{item.coordinate_source}}" class="muted">定位来源：{{item.coordinate_source}}</view><view wx:if="{{item.irrigation_management}}">供水：{{item.irrigation_management}}</view><view wx:if="{{item.fertilizer_management}}">施肥：{{item.fertilizer_management}}</view><view class="muted">档案 {{item.completeness.filled}}/{{item.completeness.total}} · 缺：{{item.missingText || '无'}}</view><view class="actions"><button data-id="{{item.plot_id}}" bindtap="select" aria-label="设为当前地块">设为当前</button><button data-id="{{item.plot_id}}" bindtap="edit" aria-label="编辑地块">编辑</button><button data-id="{{item.plot_id}}" bindtap="farm" aria-label="农事记录">农事记录</button></view></view><button wx:if="{{state !== 'empty'}}" class="primary-btn" bindtap="create">新建地块</button></view>
