<block wx:if="{{isDev}}"><view class="page"><loading-panel wx:if="{{state === 'loading'}}" text="回查证据"/><banner wx:if="{{error}}" kind="warning" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><view wx:if="{{result}}" class="panel"><view class="muted" selectable>证据编号：{{result.evidence_id}}</view><evidence-tag source-type="{{result.source_type || 'literature'}}" status="{{result.status}}" mode="{{result.mode}}"/><block wx:if="{{result.tool}}"><view class="kv">工具：{{result.tool}} · {{result.status}}</view><view class="kv">时间：{{result.time_range.start}} 至 {{result.time_range.end}}</view><view class="kv">模型：{{result.model_version}}</view><view class="kv">参数：{{result.parameter_version}}</view><view class="section-title">实际输入</view><view wx:for="{{inputs}}" wx:key="key" class="kv"><text>{{item.key}}</text><text selectable>{{item.value}}</text></view><view class="section-title">假设与限制</view><view wx:for="{{result.assumptions}}" wx:key="*this" class="kv">{{item}}</view><view wx:for="{{result.warnings}}" wx:key="*this" class="error-text">{{item}}</view><view wx:if="{{sourceRows.length}}"><view class="section-title">原始记录（共 {{total}} 条）</view><view wx:for="{{sourceRows}}" wx:key="obs_id" class="kv"><view>{{item.ts}} · {{item.value_raw}} {{item.unit}}</view><view selectable>{{item.obs_id}}</view><view selectable>文件：{{item.path}}</view><view>来源行：{{item.source_row}} · {{item.qc_flag}}</view><view selectable>SHA256：{{item.sha256}}</view><view>发布版本：{{item.data_version}} · 原版本：{{item.source_data_version || item.data_version}}</view></view><view class="btn-row"><button wx:if="{{offset > 0}}" bindtap="previous" disabled="{{paging}}">上一页</button><button wx:if="{{nextOffset !== null}}" bindtap="next" disabled="{{paging}}">下一页</button></view></view></block><block wx:else><view class="section-title">{{result.title}}</view><view>{{result.doc_id}} · {{result.locator}}</view><text selectable>{{result.snippet}}</text></block></view><view wx:if="{{source}}" class="panel section"><view class="section-title">原始记录</view><view class="kv" selectable>文件：{{source.path}}</view><view class="kv">行号：{{source.source_row}}</view><view class="kv">原始值：{{source.value_raw}}</view><view class="kv">质量：{{source.qc_flag}}</view><view class="kv">发布版本：{{source.data_version}} · 原版本：{{source.source_data_version || source.data_version}}</view><view class="kv" selectable>SHA256：{{source.sha256}}</view><text class="muted">{{source.source_type === 'fixture' ? '构造测试记录，不是实测' : '原始观测文件记录'}}</text></view></view></block><view wx:else class="page"><view class="panel">请返回查看业务结果</view></view>
