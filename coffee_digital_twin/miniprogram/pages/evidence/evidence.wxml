<view class="page"><view class="page-title">证据详情</view><loading-panel wx:if="{{state === 'loading'}}" text="回查证据"/><banner wx:if="{{error}}" kind="warning" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><view wx:if="{{result}}" class="panel"><evidence-tag source-type="{{result.source_type || 'literature'}}" status="{{result.status}}" mode="{{result.mode}}"/><block wx:if="{{result.tool}}"><view class="kv">工具：{{result.tool}} · {{result.status}}</view><view class="kv">时间：{{result.time_range.start}} 至 {{result.time_range.end}}</view><view class="kv">模型：{{result.model_version}}</view><view class="kv">参数：{{result.parameter_version}}</view><view class="section-title">实际输入</view><view wx:for="{{inputs}}" wx:key="key" class="kv"><text>{{item.key}}</text><text selectable>{{item.value}}</text></view><view class="section-title">假设与限制</view><view wx:for="{{result.assumptions}}" wx:key="*this" class="kv">{{item}}</view><view wx:for="{{result.warnings}}" wx:key="*this" class="error-text">{{item}}</view><button wx:for="{{sources}}" wx:key="*this" data-id="{{item}}" bindtap="source">逐条回查 {{item}}</button></block><block wx:else><view class="section-title">{{result.title}}</view><view>{{result.doc_id}} · {{result.locator}}</view><text selectable>{{result.snippet}}</text></block></view><view wx:if="{{source}}" class="panel section"><view class="section-title">原始记录</view><view class="kv" selectable>文件：{{source.path}}</view><view class="kv">行号：{{source.source_row}}</view><view class="kv">原始值：{{source.value_raw}}</view><view class="kv">质量：{{source.qc_flag}}</view><view class="kv">版本：{{source.data_version}}</view><view class="kv" selectable>SHA256：{{source.sha256}}</view><text class="muted">{{source.source_type === 'fixture' ? '构造测试记录，不是实测' : '原始观测文件记录'}}</text></view></view>