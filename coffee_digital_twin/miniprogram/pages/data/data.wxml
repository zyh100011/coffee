<view class="page">
  <plot-bar plot="{{plot}}"/>
  <banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答由规则生成，仅用于联调"/>
  <banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放，具体生成时间见证据"/>
  <banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/>
  <loading-panel wx:if="{{state === 'loading'}}" text="加载中"/>
  <view class="page-title">农情查询</view>
  <view wx:if="{{importStatus.observations.n}}" class="panel section">
    <view>已入库 {{importStatus.observations.n}} 条历史监测记录</view>
    <view class="muted">{{importStatus.observations.start}} 至 {{importStatus.observations.end}}</view>
    <view wx:for="{{statusWarnings}}" wx:key="*this" class="muted">{{item}}</view>
    <view wx:if="{{missingText}}" class="muted">尚缺：{{missingText}}</view>
  </view>
  <empty-state wx:if="{{state === 'empty'}}" title="该地块暂无入库数据" desc="请先选择已导入数据的地块或完成数据导入" action-text="地块管理" bind:action="create"/>
  <view wx:if="{{options.length}}" class="panel section">
    <picker range="{{options}}" range-key="label" value="{{selected}}" bindchange="select" aria-label="选择参数、监测来源和单位"><view class="picker">{{options[selected].label}} ▾</view></picker>
    <picker mode="date" value="{{start}}" start="{{options[selected].start}}" end="{{options[selected].end}}" data-key="start" bindchange="dates" aria-label="查询开始日期"><view class="picker">开始：{{start}}</view></picker>
    <picker mode="date" value="{{end}}" start="{{start}}" end="{{options[selected].end}}" data-key="end" bindchange="dates" aria-label="查询结束日期"><view class="picker">结束：{{end}}</view></picker>
    <picker range="{{aggs}}" value="{{aggIndex}}" bindchange="agg" aria-label="选择日均读数或原始记录"><view class="picker">{{aggs[aggIndex]}} ▾</view></picker>
    <view><switch checked="{{includeFlagged}}" bindchange="flagged" aria-label="包含待核查的异常或单位缺失记录"/>包含待核查记录</view>
    <button class="primary-btn" loading="{{querying}}" disabled="{{querying}}" bindtap="query">查询</button>
  </view>
  <view wx:if="{{result}}" class="panel">
    <evidence-tag source-type="{{result.source_type}}" status="{{result.status}}"/>
    <text class="muted">版本：{{result.parameter_version}}</text>
    <msg-blocks blocks="{{blocks}}" bind:openevidence="openEvidence"/>
    <button wx:if="{{result.outputs.next_offset !== null}}" disabled="{{querying}}" bindtap="nextPage">下一页记录</button>
    <view class="section-title">当前页来源（最多20条）</view>
    <button wx:for="{{result.outputs.source_obs_ids}}" wx:key="*this" data-id="{{item}}" bindtap="source" aria-label="回查原文件行号">{{item}} ›</button>
  </view>
  <banner wx:if="{{reportError}}" kind="warning" text="{{reportError}}" action-text="重试" bind:action="reload"/>
  <view wx:if="{{reports.length}}" class="panel section">
    <view class="section-title">土壤检测报告 · {{reports.length}}个样品</view>
    <evidence-tag source-type="observation" status="success"/>
    <view class="muted">普洱南岛河基地 · 报告编号2026T108</view>
    <picker range="{{reports}}" range-key="lab_sample_id" value="{{reportIndex}}" bindchange="reportSelect" aria-label="选择土壤检测样品"><view class="picker">{{reports[reportIndex].lab_sample_id}} · {{reports[reportIndex].sample_label}} ▾</view></picker>
    <view class="muted">报告日：{{reports[reportIndex].report_date}}；收样日：{{reports[reportIndex].received_date}}</view>
    <view class="muted">采样日期和深度未提供；原PDF第{{reports[reportIndex].source_page}}页</view>
    <view wx:for="{{reports[reportIndex].measurements}}" wx:key="result_id" class="section">
      <view>{{item.item}}：{{item.displayValue}} {{item.unit}}</view><view class="muted">方法：{{item.method}}</view>
    </view>
    <view wx:for="{{reportWarnings}}" wx:key="*this" class="muted">{{item}}</view>
  </view>
</view>
