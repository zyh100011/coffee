<view class="page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，报告需区分演示来源"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放"/><loading-panel wx:if="{{state === 'loading'}}" text="读取报告"/><banner wx:if="{{error}}" kind="warning" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><empty-state wx:if="{{state === 'empty'}}" title="暂无本地块报告" desc="在问答回复下点击生成报告"/><block wx:if="{{!report}}"><view class="page-title">历史报告</view><button wx:for="{{items}}" wx:key="report_id" data-id="{{item.report_id}}" bindtap="open">{{item.created_at}} · {{item.source_id}} ›</button></block><block wx:else><view class="page-title">循证决策报告</view><banner wx:if="{{report.service_mode === 'mock'}}" kind="mock" text="本报告由 MOCK 联调轨迹生成，不是正式循证结果"/><view class="muted section">问题：{{report.question}} · {{report.created_at}}</view><view wx:for="{{sections}}" wx:for-item="section" wx:key="title" class="panel section"><view class="section-title">{{section.title}}<evidence-tag wx:for="{{section.evidence}}" wx:for-item="ev" wx:key="evidence_id" source-type="{{ev.source_type}}" status="{{ev.status}}" mode="{{ev.mode}}"/></view><view wx:if="{{section.note}}" class="muted">{{section.note}}</view><msg-blocks blocks="{{section.blocks}}" bind:openevidence="evidence"/><view wx:for="{{section.items}}" wx:for-item="row" wx:key="index" class="kv"><text wx:if="{{row.text}}" selectable>{{row.text}}</text></view><button wx:for="{{section.evidence_ids}}" wx:for-item="id" wx:key="*this" data-id="{{id}}" bindtap="evidence">依据：{{id}} ›</button></view><button class="primary-btn" bindtap="copy">复制 HTML 报告链接</button><view class="muted">在电脑浏览器打开后可打印为 PDF</view></block></view>