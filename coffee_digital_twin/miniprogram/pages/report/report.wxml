<view class="page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，报告需区分演示来源"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放"/><loading-panel wx:if="{{state === 'loading'}}" text="读取报告"/><banner wx:if="{{error}}" kind="warning" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><empty-state wx:if="{{state === 'empty'}}" title="暂无本地块报告" desc="在问答回复下点击生成报告"/><block wx:if="{{!report}}"><view wx:if="{{items.length}}" class="panel section"><view class="card-head"><view class="ic-box tint-brown"><image class="ic-img" src="/images/ic/report.png"/></view><view class="grow"><view class="title">历史报告</view><view class="sub">共 {{items.length}} 份</view></view></view><view wx:for="{{items}}" wx:key="report_id" data-id="{{item.report_id}}" bindtap="open" class="report-row" aria-role="button" aria-label="查看报告"><text>{{item.created_at}}</text><text class="go">查看 ›</text></view></view></block><block wx:else><banner wx:if="{{report.service_mode === 'mock'}}" kind="mock" text="本报告由 MOCK 联调轨迹生成，不是正式循证结果"/><view class="muted section">问题：{{report.question}} · {{report.created_at}}</view><view wx:for="{{isDev ? sections : userSections}}" wx:for-item="section" wx:key="title" class="panel section"><view class="section-title">{{section.title}}<evidence-tag wx:for="{{section.evidence}}" wx:for-item="ev" wx:key="evidence_id" source-type="{{ev.source_type}}" status="{{ev.status}}" mode="{{ev.mode}}"/></view><view wx:if="{{isDev && section.note}}" class="muted">{{section.note}}</view><msg-blocks blocks="{{section.blocks}}" bind:openevidence="evidence"/><view wx:for="{{section.items}}" wx:for-item="row" wx:key="index" class="kv"><text wx:if="{{row.text}}" selectable>{{row.text}}</text></view><button wx:if="{{isDev}}" class="btn-link" wx:for="{{section.evidence_ids}}" wx:for-item="id" wx:key="*this" data-id="{{id}}" bindtap="evidence">查看本节依据 ›</button></view><button class="primary-btn" bindtap="copy">复制 HTML 报告链接</button><view class="muted">在电脑浏览器打开后可打印为 PDF</view></block></view>