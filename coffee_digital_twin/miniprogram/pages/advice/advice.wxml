<view class="page advice-page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答由规则生成，仅用于联调"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放"/><view class="page-title">循证问答</view><view class="muted section">回答会标出处、数据来源和缺项</view><banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="retry"/><scroll-view scroll-y scroll-into-view="{{scrollTarget}}" class="chat-stream"><view wx:for="{{messages}}" wx:key="id" class="message {{item.role}}"><view class="avatar">{{item.role === 'user' ? '你' : '助手'}}</view><view class="bubble"><text wx:if="{{item.role === 'user'}}" selectable>{{item.content}}</text><block wx:else><msg-blocks blocks="{{item.blocks}}" disabled="{{typing}}" bind:quickreply="quick" bind:openevidence="openEvidence" bind:openreport="openReport"/><button data-trace="{{item.traceId}}" bindtap="generateReport" loading="{{creatingReport}}" disabled="{{creatingReport || typing}}">生成报告</button></block></view></view><view wx:if="{{!messages.length}}" class="panel"><view class="section-title">可以这样提问</view><button wx:for="{{samples}}" wx:key="*this" data-text="{{item}}" bindtap="sample" disabled="{{typing}}">{{item}}</button></view><loading-panel wx:if="{{typing}}" text="处理中（显示为等待动画，实际过程见返回轨迹）" steps="{{loadingSteps}}"/><view id="bottom"></view></scroll-view><view wx:if="{{pending}}" class="muted">当前正在补充上一问题的条件</view><view class="composer"><input class="input" value="{{inputText}}" bindinput="input" bindconfirm="send" placeholder="{{pending ? '补充日期、深度等条件' : '输入你的问题'}}" disabled="{{typing}}" aria-label="问题或补充条件"/><button class="primary-btn" bindtap="send" loading="{{typing}}" disabled="{{typing || !inputText}}">发送</button></view></view>