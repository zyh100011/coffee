<view class="page advice-page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答由规则生成，仅用于联调"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放"/>
<banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="retry"/><scroll-view scroll-y scroll-into-view="{{scrollTarget}}" class="chat-stream">
<view wx:if="{{!messages.length}}" class="welcome"><image class="w-avatar" src="/images/ic/avatar-bot.png"/><view class="w-title">你好，我是咖啡农事助手</view><view class="w-sub">农技知识、墒情气象、灌溉情景都可以直接问</view><view class="w-list"><view class="w-q" wx:for="{{samples}}" wx:key="*this" data-text="{{item}}" data-mode="{{index === 0 ? 'knowledge' : 'auto'}}" bindtap="sample" aria-role="button"><text>{{item}}</text><text class="go">›</text></view></view></view>
<view wx:for="{{messages}}" wx:key="id" class="message {{item.role}}"><image class="avatar" src="{{item.role === 'user' ? '/images/ic/avatar-user.png' : '/images/ic/avatar-bot.png'}}"/><view class="bubble"><text wx:if="{{item.role === 'user'}}" selectable>{{item.content}}</text><block wx:else><view wx:if="{{item.category}}" class="cat-tag">{{item.category}}</view><msg-blocks blocks="{{item.blocks}}" hide-mock="{{health.mock}}" disabled="{{typing}}" bind:quickreply="quick" bind:openevidence="openEvidence" bind:openreport="openReport"/><view class="bubble-foot"><text class="ref-note">以上内容仅供参考</text><button class="report-link" data-trace="{{item.traceId}}" bindtap="generateReport" loading="{{creatingReport}}" disabled="{{creatingReport || typing}}" aria-label="生成报告"><image class="rl-ic" src="/images/ic/report.png"/>生成报告</button></view></block></view></view>
<view wx:if="{{typing}}" class="message assistant"><image class="avatar" src="/images/ic/avatar-bot.png"/><view class="bubble typing-bubble"><loading-panel text="正在查询与生成解释" steps="{{loadingSteps}}"/></view></view>
<view id="bottom"></view></scroll-view>
<view wx:if="{{pending}}" class="pending-tip">正在补充上一问题的条件</view>
<view class="composer"><input class="c-input" maxlength="4000" value="{{inputText}}" bindinput="input" bindconfirm="send" placeholder="{{pending ? '补充日期、深度等条件' : '输入你的问题'}}" disabled="{{typing}}" aria-label="问题或补充条件"/><button class="c-send {{inputText && !typing ? 'ready' : ''}}" bindtap="send" loading="{{typing}}" disabled="{{typing || !inputText}}" aria-label="发送"><image wx:if="{{!typing}}" class="send-ic" src="/images/ic/send.png"/></button></view></view>
