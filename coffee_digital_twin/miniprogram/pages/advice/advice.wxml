<view class="page advice-page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答由规则生成，仅用于联调"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放"/>
<view class="entry-modes">
  <button class="{{entryMode === 'auto' ? 'primary-btn' : ''}}" data-mode="auto" bindtap="chooseMode" disabled="{{typing}}" aria-label="综合问答，查询数据或模型结果">综合问答{{entryMode === 'auto' ? '（当前）' : ''}}</button>
  <button class="{{entryMode === 'knowledge' ? 'primary-btn' : ''}}" data-mode="knowledge" bindtap="chooseMode" disabled="{{typing}}" aria-label="农技知识，查资料和出处">农技知识{{entryMode === 'knowledge' ? '（当前）' : ''}}</button>
</view>
<view wx:if="{{isDev}}" class="muted entry-hint">{{entryMode === 'knowledge' ? '查询农技资料与出处；查监测数据或模型结果请选择综合问答。' : '可查询农情、解释已有结果；通用农技问题请选择农技知识。'}}</view>
<banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="retry"/><scroll-view scroll-y scroll-into-view="{{scrollTarget}}" class="chat-stream"><view wx:for="{{messages}}" wx:key="id" class="message {{item.role}}"><view class="avatar">{{item.role === 'user' ? '你' : '助手'}}</view><view class="bubble"><text wx:if="{{item.role === 'user'}}" selectable>{{item.content}}</text><block wx:else><msg-blocks blocks="{{item.blocks}}" hide-mock="{{health.mock}}" disabled="{{typing}}" bind:quickreply="quick" bind:openevidence="openEvidence" bind:openreport="openReport"/><button class="btn-link" data-trace="{{item.traceId}}" bindtap="generateReport" loading="{{creatingReport}}" disabled="{{creatingReport || typing}}">生成报告</button></block></view></view><view wx:if="{{!messages.length}}" class="panel"><view class="section-title">可以这样提问</view><button class="chip" wx:for="{{samples}}" wx:key="*this" data-text="{{item}}" data-mode="{{index === 0 ? 'knowledge' : 'auto'}}" bindtap="sample" disabled="{{typing}}">{{item}}</button></view><loading-panel wx:if="{{typing}}" text="正在查询与生成解释" steps="{{loadingSteps}}"/><view id="bottom"></view></scroll-view><view wx:if="{{pending}}" class="muted">当前正在补充上一问题的条件</view><view class="composer"><input class="input" maxlength="4000" value="{{inputText}}" bindinput="input" bindconfirm="send" placeholder="{{pending ? '补充日期、深度等条件' : '输入你的问题'}}" disabled="{{typing}}" aria-label="问题或补充条件"/><button class="primary-btn" bindtap="send" loading="{{typing}}" disabled="{{typing || !inputText}}">发送</button></view></view>