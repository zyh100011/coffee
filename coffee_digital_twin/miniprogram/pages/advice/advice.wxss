.chat-stream{height:58vh;}.message{display:flex;gap:16rpx;margin-bottom:24rpx;align-items:flex-start;}.avatar{font-size:24rpx;min-width:64rpx;background:#eceff1;padding:12rpx 8rpx;border-radius:8rpx;text-align:center;}.bubble{flex:1;min-width:0;background:#ffffff;border:1rpx solid #dfe7df;padding:24rpx;border-radius:8rpx;overflow-wrap:anywhere;}.user .bubble{background:#e4f2e9;}.composer{display:flex;gap:16rpx;align-items:center;margin-top:24rpx;}.composer input{flex:1;min-width:0;}.composer button{flex:0 0 auto;}.advice-page{display:flex;flex-direction:column;}