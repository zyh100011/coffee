<view class="page">
 <plot-bar plot="{{plot}}"/>
 <view wx:if="{{isDev && mode === 'replay'}}" class="page-subtitle"><text class="replay-title">历史结果回放</text></view>
 <banner wx:if="{{mode === 'replay'}}" kind="replay" text="历史结果回放：只解释历史假设案例，保留原日期，不代表当前地块新计算"/>
 <banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="retry"/>
 <loading-panel wx:if="{{state === 'loading'}}" text="加载地块"/>
 <empty-state wx:if="{{!plot && state !== 'loading'}}" title="请选择地块" action-text="选择或录入地块" bind:action="plots"/>
 <block wx:if="{{plot}}">
 <view class="steps" aria-label="情景步骤，当前第{{step}}步">
  <view class="st {{step >= 1 ? 'on' : ''}}"><text class="n">1</text><text class="l">设定</text></view><view class="bar {{step >= 2 ? 'on' : ''}}"></view>
  <view class="st {{step >= 2 ? 'on' : ''}}"><text class="n">2</text><text class="l">确认</text></view><view class="bar {{step >= 3 ? 'on' : ''}}"></view>
  <view class="st {{step >= 3 ? 'on' : ''}}"><text class="n">3</text><text class="l">对比</text></view>
 </view>
 <view wx:if="{{step === 1}}" class="panel section">
  <view class="card-head"><view class="ic-box tint-teal"><image class="ic-img" src="/images/ic/scenario.png"/></view><view class="grow"><view class="title">如果多浇一次水</view><view class="sub">比较土壤水分的变化</view></view></view>
  <view wx:if="{{isDev}}" class="muted">按历史监测窗口模拟 · 数据截至 {{dataEnd || '未提供'}}</view>
  <picker mode="date" value="{{start}}" start="{{minStart}}" end="{{maxStart}}" bindchange="date" disabled="{{running}}" aria-label="模拟起始日期"><view class="picker"><view class="pk"><text class="k">起始日期</text><text class="v">{{start}}</text></view><text class="arrow">▾</text></view></picker>
  <view class="amount-box">
   <view class="amount-head"><text class="muted">第 1 天额外灌溉</text><view class="amount"><text class="amount-num">{{amount || 0}}</text><text class="amount-unit">mm</text></view></view>
   <slider min="0" max="100" step="5" value="{{sliderValue}}" bindchange="amount" disabled="{{running}}" activeColor="#16857a" backgroundColor="#d8e6e2" block-size="24" aria-label="额外灌溉0至100毫米"/>
   <view class="quick"><button class="chip q" data-amount="10" bindtap="quick" disabled="{{running}}">+10mm</button><button class="chip q" data-amount="20" bindtap="quick" disabled="{{running}}">+20mm</button><button class="chip q" data-amount="30" bindtap="quick" disabled="{{running}}">+30mm</button></view>
   <view class="exact"><text class="muted">精确输入</text><input class="input exact-input" type="digit" value="{{amount}}" bindinput="amount" disabled="{{running}}" aria-label="额外灌溉毫米数"/><text class="muted">mm</text></view>
  </view>
  <view class="error-text" wx:if="{{fieldError}}">{{fieldError}}</view><view wx:if="{{isDev}}" class="muted">模拟假设，非实际灌溉指令。基线与假设将在下一步由后端列出。</view>
  <button class="primary-btn" bindtap="next" loading="{{running}}" disabled="{{running}}">下一步</button>
 </view>
 <view wx:if="{{step === 2 && preview}}" class="panel section">
  <view class="card-head"><view class="ic-box tint-teal"><image class="ic-img" src="/images/ic/scenario.png"/></view><view class="grow"><view class="title">确认比较条件</view></view><evidence-tag source-type="simulation_uncalibrated" mode="{{mode}}"/></view>
  <view class="kv-list">
   <view class="kv-row"><text class="kk">基线</text><text class="vv">{{isDev ? preview.confirmation.baseline : '当前管理条件'}}</text></view>
   <view class="kv-row"><text class="kk">变化</text><text class="vv">{{preview.confirmation.change}}</text></view>
   <view class="kv-row"><text class="kk">起始</text><text class="vv">{{preview.confirmation.start_date}} · {{preview.confirmation.window_days}} 天</text></view>
  </view>
  <block wx:if="{{isDev}}"><view class="section-title">窗口内已记录灌溉</view><view wx:if="{{!preview.confirmation.recorded_irrigation.length}}">无；记录缺失不证明实际未灌溉</view>
  <view wx:for="{{preview.confirmation.recorded_irrigation}}" wx:key="index">{{item.date || item.op_date}} · {{item.normalized_mm}}mm · 农事记录</view>
  <view wx:for="{{preview.confirmation.historical_cases}}" wx:key="evidence_id">历史窗口：{{item.time_range.start}} 至 {{item.time_range.end}} · 生成于 {{item.created_at}}</view>
  <view class="section-title">假设与限制</view><view wx:for="{{preview.assumptions}}" wx:key="*this" class="limit">• {{item}}</view>
  <banner kind="warning" text="模拟假设，非实际灌溉指令"/></block>
  <view class="btn-row"><button class="ghost-btn" bindtap="back" disabled="{{running}}">返回修改</button><button class="primary-btn" bindtap="confirm" loading="{{running}}" disabled="{{running}}">确认运行</button></view>
 </view>
 <block wx:if="{{step === 3}}">
  <loading-panel wx:if="{{running}}" text="HYDRUS 计算中（最长约60秒）"/>
  <view wx:if="{{result && result.parameter_verified}}" class="panel section">
   <view class="card-head"><view class="ic-box tint-teal"><image class="ic-img" src="/images/ic/chart.png"/></view><view class="grow"><view class="title">基线与多浇水对比</view><view class="sub">{{result.time_range.start}} 至 {{result.time_range.end}}</view></view><evidence-tag source-type="simulation_uncalibrated" mode="{{result.mode}}"/></view>
   <line-chart series="{{result.series}}" unit="cm³/cm³" height="340"/>
   <view class="tiles front">
    <view class="tile"><view class="t-label">湿润锋深度</view><view class="t-value">{{result.baselineFront}} → {{result.variantFront}}<text class="u">cm</text></view></view>
    <view class="tile"><view class="t-label">根系吸水比</view><view class="t-value">{{result.baselineUptake}} → {{result.variantUptake}}</view></view>
   </view>
   <view class="sub-title">第 7 天各深度含水率</view>
   <view class="data-table"><view class="tr th"><text>深度 cm</text><text>基线</text><text>多浇水</text><text>差值</text></view>
   <view class="tr" wx:for="{{result.rows}}" wx:key="depth_cm"><text>{{item.depth_cm}}</text><text>{{item.baselineText}}</text><text>{{item.variantText}}</text><text class="diff">{{item.differenceText}}</text></view></view>
   <block wx:if="{{isDev}}"><view class="verified">参数核验：第1天输入差值 {{result.input_diff[0]}} cm ✓（调用轨迹反读）</view>
   <button data-id="{{result.baseline.evidence_id}}" bindtap="evidence">基线输入与出处 ›</button><button data-id="{{result.variant.evidence_id}}" bindtap="evidence">变化组输入与出处 ›</button>
   <view class="section-title">未确定条件</view><view wx:for="{{result.undetermined}}" wx:key="*this" class="limit">• {{item}}</view><view wx:for="{{result.assumptions}}" wx:key="*this" class="limit">• {{item}}</view>
   </block>
   <view class="btn-row"><button class="ghost-btn" bindtap="ask">问问助手</button><button class="primary-btn" bindtap="report" loading="{{creatingReport}}" disabled="{{creatingReport}}">生成报告</button></view>
  </view>
  <view wx:if="{{result && !result.parameter_verified}}" class="panel section"><view class="section-title">情景未完成</view><view wx:if="{{isDev}}" wx:for="{{result.warnings}}" wx:key="*this" class="error-text">{{item}}</view><text class="muted">本次计算未完成，请重试。</text></view>
  <view class="btn-row"><button wx:if="{{!running}}" class="ghost-btn" bindtap="back">返回修改</button><button wx:if="{{!running && (error || (result && !result.parameter_verified))}}" class="ghost-btn" bindtap="replay">{{isDev ? '改用历史结果回放' : '查看已有结果'}}</button></view>
 </block>
 </block>
</view>
