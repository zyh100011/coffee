<view class="page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答由规则生成，仅用于联调"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放，具体生成时间见证据"/><banner wx:if="{{error}}" kind="{{state === 'offline' ? 'offline' : 'warning'}}" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><loading-panel wx:if="{{state === 'loading'}}" text="加载中"/><empty-state wx:if="{{state === 'empty'}}" title="请先选择地块" action-text="选择地块" bind:action="create"/><block wx:if="{{plot}}"><view class="page-title">农事记录</view><view class="panel section"><view wx:if="{{!items.length}}" class="muted">暂无农事记录</view><view wx:for="{{items}}" wx:key="id" class="kv"><text>{{item.op_date}}</text><text>{{item.op_type === 'irrigation' ? '灌溉' : '施肥'}} {{item.amount}} {{item.unit}}</text><text class="tag tag-proxy">记录 · 用户录入</text></view></view><view class="panel"><view class="section-title">新增记录</view><picker range="{{types}}" value="{{typeIndex}}" bindchange="changeType"><view class="picker">{{types[typeIndex]}} ▾</view></picker><picker mode="date" value="{{date}}" bindchange="changeDate"><view class="picker">日期：{{date}} ▾</view></picker><view class="field"><input class="input" type="digit" value="{{amount}}" placeholder="数量（必填且大于0）" data-key="amount" bindinput="input" aria-label="农事数量"/><view class="error-text">{{fieldError}}</view></view><picker range="{{units}}" value="{{unitIndex}}" bindchange="changeUnit"><view class="picker">单位：{{units[unitIndex]}} ▾</view></picker><input wx:if="{{typeIndex === 1}}" class="input" placeholder="肥料类型" value="{{fertilizer}}" data-key="fertilizer" bindinput="input" aria-label="肥料类型"/><input class="input" placeholder="备注" value="{{remark}}" data-key="remark" bindinput="input" aria-label="备注"/><button class="primary-btn" bindtap="save" loading="{{saving}}" disabled="{{saving || state === 'offline'}}">保存记录</button></view></block></view>
