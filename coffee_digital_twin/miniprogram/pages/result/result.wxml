<view class="page"><plot-bar plot="{{plot}}"/><banner wx:if="{{health.mock}}" kind="mock" text="当前为 MOCK 服务，回答仅用于联调"/><banner wx:if="{{health.hydrus_mode === 'replay'}}" kind="replay" text="HYDRUS 为历史结果回放"/><loading-panel wx:if="{{state === 'loading'}}" text="读取工具结果"/><banner wx:if="{{error}}" kind="warning" text="{{error.message}}" action-text="{{error.retryable ? '重试' : ''}}" bind:action="reload"/><empty-state wx:if="{{state === 'empty'}}" title="该地块暂无模型结果" desc="{{isDev ? '先通过问答运行一个明确起始日期的假设情景' : '先在情景页面运行一次计算'}}"/><block wx:if="{{result}}"><view wx:if="{{isDev || (result.status !== 'failed' && result.dashboard.risk_level)}}" class="panel section"><view wx:if="{{isDev}}" wx:for="{{tools}}" wx:key="name"><text>{{item.displayName}}</text><evidence-tag source-type="{{item.source_type}}" status="{{item.status}}" mode="{{item.mode}}"/></view><risk-badge wx:if="{{result.status !== 'failed' && result.dashboard.risk_level}}" risk="{{result.dashboard.risk_level}}"/></view><view wx:for="{{tools}}" wx:key="name" class="panel section"><view class="card-head"><view class="ic-box tint-purple"><image class="ic-img" src="/images/ic/model.png"/></view><view class="grow"><view class="title">{{item.displayName}}</view></view><evidence-tag source-type="{{item.source_type}}" status="{{item.status}}" mode="{{item.mode}}"/></view><view wx:if="{{!item.available}}" class="muted">不可用：{{item.warnings[0] || item.status}}</view><block wx:else><view wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="key" class="kv"><text>{{metric.label}}</text><text>{{metric.value}} {{metric.unit}}</text></view><block wx:if="{{item.name === 'hydrus'}}"><chart-card title="第7天土壤剖面含水率" unit="cm3/cm3" items="{{item.soil}}"/><line-chart series="{{item.series}}" unit="cm3/cm3"/></block><button wx:if="{{isDev}}" class="btn-link" bindtap="toggleAssumptions">模型假设（{{item.assumptions.length}} 条）{{assumptionsOpen ? '收起' : '›'}}</button><view wx:if="{{isDev && assumptionsOpen}}" wx:for="{{item.assumptions}}" wx:for-item="assumption" wx:key="*this" class="muted">{{assumption}}</view><button wx:if="{{isDev}}" class="btn-link" data-id="{{item.evidence_id}}" bindtap="openEvidence">查看本工具证据</button></block></view><view wx:if="{{result.available_evidence.length >= 2}}" class="panel section"><view class="section-title">可用模型综合说明</view><view>{{result.mechanism_explanation.integrated_reason}}</view><view wx:if="{{isDev}}" class="muted">{{result.mechanism_explanation.dependency_note}}</view></view><view class="panel section"><view wx:if="{{unavailableText}}" class="muted">{{unavailableText}}：本基地暂无运行结果</view><view wx:if="{{isDev}}" class="section-title">模型说明</view><view wx:if="{{isDev}}" wx:for="{{info}}" wx:key="name" class="kv">{{item.displayName}}：{{item.text}}</view></view><button bindtap="generate" loading="{{generating}}" disabled="{{generating}}">生成解释</button><view wx:if="{{advice}}" class="panel">{{advice.what}}<view wx:if="{{isDev}}" class="muted">{{advice.source}}</view></view><button class="primary-btn" bindtap="goAdvice">向助手提问</button></block></view>