.plot-bar{display:inline-flex;align-items:center;gap:10rpx;max-width:100%;box-sizing:border-box;min-height:64rpx;padding:0 24rpx 0 16rpx;margin-bottom:20rpx;border-radius:32rpx;background:#ffffff;color:#1f5a3a;font-size:25rpx;box-shadow:0 4rpx 14rpx rgba(31,90,58,.08);}
.pin{width:34rpx;height:34rpx;flex:0 0 auto;}
.name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.switch{color:#7a857d;margin-left:8rpx;flex:0 0 auto;}
.hero{position:relative;overflow:hidden;min-height:280rpx;padding:36rpx 36rpx 40rpx;margin-bottom:24rpx;border-radius:28rpx;background:linear-gradient(135deg,#2f7d50 0%,#1f5a3a 60%,#174a2f 100%);color:#ffffff;box-sizing:border-box;box-shadow:0 12rpx 30rpx rgba(31,90,58,.25);}
.hero-art{position:absolute;right:-30rpx;bottom:-10rpx;width:420rpx;height:280rpx;opacity:.95;}
.hero-tag{position:relative;display:inline-flex;align-items:center;gap:6rpx;padding:4rpx 16rpx 4rpx 10rpx;border-radius:24rpx;background:rgba(255,255,255,.16);font-size:22rpx;}
.tag-ic{width:28rpx;height:28rpx;}
.hero-name{position:relative;margin-top:20rpx;width:78%;font-size:36rpx;font-weight:700;line-height:1.3;}
.hero-sub{position:relative;margin-top:14rpx;font-size:24rpx;opacity:.85;}
