<view class="line-chart"><view class="muted">{{unit}}</view><view wx:if="{{empty}}" class="empty">暂无可绘制数据</view><canvas wx:else id="plot" type="2d" style="width:100%;height:{{height}}rpx;" aria-label="折线图，下方可查看完整数据表"/><view class="legend"><view wx:for="{{legend}}" wx:key="name"><text style="color:{{item.color}}">━</text> {{item.name}}</view></view><button class="ghost-btn" bindtap="toggle" aria-label="切换完整数据表">{{table ? '收起数据表' : '查看数据表'}}</button><view wx:if="{{table}}"><view class="table-row"><text>序列</text><text>时间</text><text>数值</text></view><view wx:for="{{rows}}" wx:key="index" class="table-row"><text>{{item.name}}</text><text>{{item.x}}</text><text>{{item.value}}</text></view></view></view>
