.block{margin:16rpx 0;word-break:break-word;}.fact{background:#f4f7f3;padding:24rpx;border:1rpx solid #dfe7df;border-radius:8rpx;}.number{font-size:44rpx;font-weight:700;margin-top:16rpx;}.number text{font-size:24rpx;font-weight:400;}.warning,.missing{background:#fff1d6;color:#8a4b00;padding:24rpx;border-radius:8rpx;}.expand,.evidence-row{min-height:88rpx;display:flex;align-items:center;gap:16rpx;flex-wrap:wrap;border-bottom:1rpx solid #dfe7df;}.evidence-row .muted{word-break:break-all;}.trace-row{font-size:24rpx;margin:16rpx 0;}
