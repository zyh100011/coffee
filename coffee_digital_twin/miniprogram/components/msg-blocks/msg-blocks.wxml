<view wx:for="{{items}}" wx:key="index" class="block">
<text wx:if="{{item.type === 'text'}}" selectable>{{item.text}}</text>
<view wx:elif="{{item.type === 'fact'}}" class="fact" bindtap="evidence" data-id="{{item.evidence_id}}" aria-role="button" aria-label="查看{{item.label}}证据"><view>{{item.label}} <evidence-tag source-type="{{item.source_type}}"/></view><view class="number">{{item.displayValue}} <text>{{item.unit}} ›</text></view></view>
<line-chart wx:elif="{{item.type === 'chart'}}" series="{{item.series}}" unit="{{item.unit}}"/>
<view wx:elif="{{item.type === 'missing'}}" class="missing"><view>{{item.question}}</view><view class="muted">缺项：{{item.fields}}</view><button wx:for="{{item.quick_replies}}" wx:for-item="reply" wx:key="*this" data-text="{{reply}}" bindtap="quick" disabled="{{disabled}}" aria-label="补充{{reply}}">{{reply}}</button></view>
<view wx:elif="{{item.type === 'warning'}}" class="warning">{{item.text}}</view>
<view wx:elif="{{item.type === 'check_items'}}"><view class="section-title">现场核查事项</view><view wx:for="{{item.items}}" wx:for-item="check" wx:key="*this">□ {{check}}</view></view>
<view wx:elif="{{item.type === 'evidence'}}"><view bindtap="expand" data-index="{{index}}" class="expand" aria-role="button" aria-label="展开依据">依据 · {{item.items.length}} 条 {{item.expanded ? '收起' : '展开'}} ›</view><view wx:if="{{item.expanded}}" wx:for="{{item.items}}" wx:for-item="ev" wx:key="evidence_id" bindtap="evidence" data-id="{{ev.evidence_id}}" class="evidence-row" aria-role="button" aria-label="查看证据{{ev.evidence_id}}"><text>{{ev.label}}</text><text class="muted">{{ev.evidence_id}} ›</text></view></view>
<view wx:elif="{{item.type === 'trace'}}"><view bindtap="expand" data-index="{{index}}" class="expand" aria-role="button" aria-label="展开处理轨迹">处理过程 {{item.stepCount}}/{{item.steps.length}} 完成 ›</view><view wx:if="{{item.expanded}}" wx:for="{{item.steps}}" wx:for-item="step" wx:key="index" class="trace-row">{{step.name || step.step}} · {{step.status}} {{step.detail}}</view><text wx:if="{{item.expanded}}" class="muted" selectable>{{item.trace_id}}</text></view>
<button wx:elif="{{item.type === 'report_link'}}" data-id="{{item.report_id}}" bindtap="report" aria-label="打开报告">查看报告</button>
</view>
