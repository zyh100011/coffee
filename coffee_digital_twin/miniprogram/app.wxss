page {
  min-height: 100vh;
  background: #f4f7f3;
  color: #1d2a22;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  margin: 12rpx 0 18rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.muted {
  color: #5f6b63;
  font-size: 24rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #dfe7df;
  border-radius: 8rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item,
.grid-2 .field,
.grid-2 button {
  width: 48%;
  box-sizing: border-box;
}

.primary-btn,
.ghost-btn {
  min-height: 88rpx;
  height: auto;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.primary-btn {
  background: #1f5a3a;
  color: #ffffff;
}

.ghost-btn {
  background: #ffffff;
  color: #1f5a3a;
  border: 1rpx solid #b9cdbf;
}

.field {
  margin-bottom: 20rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: #46554b;
  font-size: 26rpx;
}

.input,
.picker {
  width: 100%;
  min-height: 76rpx;
  border: 1rpx solid #cfd9d1;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 0 18rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.textarea {
  min-height: 150rpx;
  padding-top: 16rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.actions button {
  flex: 1;
}

page{--color-primary:#1f5a3a;--color-text:#1d2a22;--color-muted:#5f6b63;--observation:#e4f2e9;--literature:#e3ecf8;--simulation:#fff1d6;--proxy:#eceff1;--replay:#efeafb;--demo:#b42318;font-size:28rpx;}
.tag{display:inline-block;padding:6rpx 12rpx;border-radius:8rpx;font-size:24rpx;margin:4rpx;white-space:normal;}
.tag-observation{color:#1f6b40;background:#e4f2e9;}.tag-literature{color:#1d4f91;background:#e3ecf8;}.tag-simulation{color:#8a4b00;background:#fff1d6;}.tag-proxy{color:#4b5563;background:#eceff1;}.tag-replay{color:#5b3fa0;background:#efeafb;}.tag-demo{color:#fff;background:#b42318;}
.banner{padding:24rpx;margin-bottom:24rpx;border-radius:8rpx;display:flex;gap:16rpx;flex-wrap:wrap;align-items:center;}.banner-mock{color:white;background:#b42318;}.banner-replay{color:#5b3fa0;background:#efeafb;}.banner-offline{color:#4b5563;background:#eceff1;}.banner-warning{color:#8a4b00;background:#fff1d6;}
.primary-btn,.ghost-btn{min-height:88rpx;height:auto;padding:16rpx;}.input,.picker{min-height:88rpx;}.page-title{font-size:36rpx;font-weight:700;margin:24rpx 0;}.error-text{color:#b42318;font-size:24rpx;margin:8rpx 0;}.panel{overflow-wrap:anywhere;}.kv{padding:16rpx 0;border-bottom:1rpx solid #dfe7df;display:flex;gap:16rpx;flex-wrap:wrap;}.kv text{word-break:break-word;}button{min-height:88rpx;} .page{padding-bottom:48rpx;}

/* FIX-03：覆盖微信原生按钮的默认字号和固定宽度。 */
button{box-sizing:border-box;font-size:28rpx !important;font-weight:400 !important;line-height:1.4;padding:16rpx 24rpx;border-radius:8rpx;}
button:not([size='mini']){width:100% !important;}
button::after{border:none;}
.btn-row,.actions{display:flex;flex-wrap:nowrap;gap:16rpx;}
.btn-row button,.actions button{width:0 !important;min-width:0;flex:1 1 0;padding-left:8rpx;padding-right:8rpx;}
.btn-link{background:transparent;color:#1f5a3a;border:0;font-size:26rpx !important;text-align:left;min-height:88rpx;}
button.chip{width:auto !important;max-width:100%;background:#e4f2e9;color:#1f5a3a;font-size:26rpx !important;text-align:left;margin:8rpx 8rpx 8rpx 0;display:inline-flex;align-items:center;white-space:normal;}
.page-subtitle{font-size:24rpx;color:#5f6b63;margin:16rpx 0;}

/* UI-2：统一视觉。只改展示，不改数据。 */
page{background:#f5f3ee;color:#1d2a22;font-size:28rpx;line-height:1.55;}
.page{padding:24rpx 28rpx 48rpx;}
.panel{background:#ffffff;border:0;border-radius:24rpx;padding:28rpx;box-shadow:0 6rpx 24rpx rgba(31,90,58,.07);}
.section{margin-bottom:24rpx;}
.section-title{display:flex;align-items:center;gap:12rpx;margin:0 0 20rpx;font-size:30rpx;font-weight:600;color:#183927;}
.section-title .ic{width:40rpx;height:40rpx;flex:0 0 auto;}
.card-head{display:flex;align-items:center;gap:16rpx;margin-bottom:20rpx;}
.card-head .ic-box{width:64rpx;height:64rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;}
.card-head .ic-img,.section-title .ic{width:40rpx;height:40rpx;}
.card-head .title{font-size:30rpx;font-weight:600;color:#183927;}
.card-head .sub{font-size:22rpx;color:#7a857d;margin-top:2rpx;}
.card-head .grow{flex:1;min-width:0;}
.tint-green{background:#e6f2ea;}.tint-blue{background:#e5f0f8;}.tint-brown{background:#f3eae1;}.tint-orange{background:#fbefdc;}.tint-purple{background:#ecebf8;}.tint-teal{background:#e0f2ef;}
.muted{color:#7a857d;font-size:24rpx;}
.picker{display:flex;align-items:center;justify-content:space-between;min-height:84rpx;padding:0 24rpx;border:0;border-radius:16rpx;background:#f3f5f1;font-size:27rpx;color:#24352a;margin-bottom:16rpx;}
.picker .k{color:#7a857d;font-size:22rpx;margin-right:12rpx;}
.input{border:0;border-radius:16rpx;background:#f3f5f1;padding:0 24rpx;}
button{background:#eef4ef;color:#1f5a3a;border-radius:16rpx;margin-top:16rpx;}
.primary-btn,button.primary-btn{background:linear-gradient(135deg,#2a7049,#1f5a3a);color:#ffffff;border:0;border-radius:44rpx;font-weight:600 !important;box-shadow:0 8rpx 20rpx rgba(31,90,58,.22);}
.ghost-btn{background:#ffffff;color:#1f5a3a;border:1rpx solid #c9dacd;border-radius:44rpx;}
button.chip{background:#eef4ef;color:#1f5a3a;border-radius:32rpx;padding:12rpx 26rpx;min-height:0;font-size:25rpx !important;}
.btn-link{color:#2a7049;}
.grid-2{display:flex;flex-wrap:wrap;justify-content:space-between;}
.grid-2>.half{width:48.5%;}
.kv{border-bottom:1rpx solid #eef1ec;}
.tiles{display:flex;flex-wrap:wrap;gap:16rpx;}
.tile{flex:1 1 40%;min-width:0;background:#f6f8f4;border-radius:18rpx;padding:20rpx;}
.tile .t-label{font-size:22rpx;color:#7a857d;}
.tile .t-value{font-size:32rpx;font-weight:600;color:#183927;margin-top:4rpx;overflow-wrap:anywhere;}
.tile .u{font-size:22rpx;font-weight:400;color:#7a857d;margin-left:4rpx;}
.pill{display:inline-flex;align-items:center;padding:6rpx 18rpx;border-radius:24rpx;font-size:22rpx;background:#eef4ef;color:#1f5a3a;margin:0 10rpx 10rpx 0;}
.data-table{border-radius:16rpx;overflow:hidden;background:#f9faf8;}
.data-table .tr{display:flex;padding:16rpx 20rpx;font-size:24rpx;border-bottom:1rpx solid #eef1ec;}
.data-table .tr>text,.data-table .tr .wx-text{flex:1;min-width:0;}
.data-table .th{background:#eef4ef;color:#46554b;font-weight:600;}
.page-title{font-size:36rpx;font-weight:700;margin:8rpx 0 24rpx;color:#183927;}
.page-subtitle{font-size:24rpx;color:#7a857d;margin:8rpx 0 16rpx;}
