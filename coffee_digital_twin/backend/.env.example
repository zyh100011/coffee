# Copy to .env and fill local settings. Never commit .env or secrets.
EVIDENCE_SERVICE_URL=http://127.0.0.1:8001
# CJY live API: configure a reachable business API URL (remote loopback is not this PC).
# Backend only. Never put this token in the miniprogram, Git, or shared documents.
EVIDENCE_API_TOKEN=
# Empty engine paths use server/*_engine defaults.
HYDRUS_EXE=
APSIM_EXE=
HYDRUS_TIMEOUT_S=60
HYDRUS_MODE=live
ALLOW_DEMO_FALLBACK=0
FLASK_DEBUG=0
DATA_VERSION=
SINGLE_PLOT_ID=plot_catimor_project
# Optional isolation for tests and baseline verification:
COFFEE_DB_PATH=
COFFEE_RUNTIME_DIR=
